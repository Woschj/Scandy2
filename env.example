# ========================================
# SCANDY - Environment Variables
# ========================================

# === APP SETTINGS ===
APP_PORT=5000
SECRET_KEY=change_me_to_a_long_random_string
FLASK_ENV=production
SYSTEM_NAME=Scandy
TIMEZONE=Europe/Berlin

# === MONGODB SETTINGS ===
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me_immediately
MONGODB_DB=scandy
MONGO_PORT=27017

# === MONGO EXPRESS SETTINGS ===
ME_PORT=8081
ME_BASICAUTH_USER=admin
ME_BASICAUTH_PASSWORD=change_me_immediately

# === SECURITY SETTINGS ===
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# === FEATURE FLAGS ===
ENABLE_TICKET_SYSTEM=true
ENABLE_JOB_BOARD=false
ENABLE_WEEKLY_REPORTS=true
